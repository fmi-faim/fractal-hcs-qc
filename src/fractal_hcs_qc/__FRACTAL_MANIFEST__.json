{
  "manifest_version": "2",
  "task_list": [
    {
      "name": "Consolidate Tables",
      "category": "Table Processing",
      "tags": [
        "Tables",
        "HCS"
      ],
      "docs_info": "",
      "type": "non_parallel",
      "executable_non_parallel": "consolidate_tables_task.py",
      "meta_non_parallel": {
        "cpus_per_task": 1,
        "mem": 4000
      },
      "args_schema_non_parallel": {
        "$defs": {
          "TableBackend": {
            "description": "Pydantic model for table backend validation.",
            "properties": {
              "backend": {
                "default": "csv",
                "enum": [
                  "anndata",
                  "json",
                  "csv",
                  "parquet"
                ],
                "title": "Backend",
                "type": "string"
              }
            },
            "title": "TableBackend",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "zarr_urls": {
            "items": {
              "type": "string"
            },
            "title": "Zarr Urls",
            "type": "array",
            "description": "URLs to the OME-Zarr containers."
          },
          "zarr_dir": {
            "title": "Zarr Dir",
            "type": "string",
            "description": "Directory to store the OME-Zarr containers."
          },
          "overlap_label_prefix": {
            "default": "Cells",
            "title": "Overlap Label Prefix",
            "type": "string",
            "description": "Prefix for the overlap labels. Defaults to \"Cells\"."
          },
          "nucleus_table_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Nucleus Table Name",
            "description": "Name of the nucleus table (parent). Defaults to None, which skips nucleus processing."
          },
          "cytoplasm_table_name": {
            "default": "Cytoplasm_features",
            "title": "Cytoplasm Table Name",
            "type": "string",
            "description": "Name of the cytoplasm table (parent). Defaults to \"Cytoplasm_features\"."
          },
          "child_object_table_names": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Child Object Table Names",
            "description": "Names of the child object tables. Defaults to None."
          },
          "table_backend": {
            "anyOf": [
              {
                "$ref": "#/$defs/TableBackend"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Table Backend",
            "description": "Backend for table operations. Defaults to None."
          }
        },
        "required": [
          "zarr_urls",
          "zarr_dir"
        ],
        "type": "object",
        "title": "ConsolidateTablesTask"
      }
    }
  ],
  "has_args_schemas": true,
  "args_schema_version": "fractal_schema_v1",
  "authors": "Facility for Advanced Imaging and Microscopy (FAIM), FMI, Basel"
}
